#!/usr/bin/env bash

dotenv_if_exists

export DIRENV_WARN_TIMEOUT=20s

# Write HF_TOKEN to a file accessible by the Nix build daemon.
# impureEnvVars don't propagate in macOS multi-user Nix, so the
# fetcher reads from this file instead.
if [[ -n "${HF_TOKEN:-}" ]]; then
  (umask 077 && printf '%s' "$HF_TOKEN" > /tmp/nix-model-repo-hf-token)
else
  rm -f /tmp/nix-model-repo-hf-token
fi

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence all output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv
